{
  "name": "jarvis-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS - Personal AI Computer Agent for Windows",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@jarvis/backend",
    "dev:desktop": "npm run dev --workspace=@jarvis/desktop",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:desktop\"",
    "build:shared": "npm run build --workspace=@jarvis/shared",
    "build:security": "npm run build --workspace=@jarvis/security",
    "build:ai": "npm run build --workspace=@jarvis/ai",
    "build:voice": "npm run build --workspace=@jarvis/voice",
    "build:tools": "npm run build --workspace=@jarvis/tools",
    "build:agent": "npm run build --workspace=@jarvis/agent",
    "build:backend": "npm run build --workspace=@jarvis/backend",
    "build:desktop": "npm run build --workspace=@jarvis/desktop",
    "build": "npm run build:shared && npm run build:security && npm run build:ai && npm run build:voice && npm run build:tools && npm run build:agent && npm run build:backend && npm run build:desktop",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
